{
  "name": "checkout-mcp",
  "main": "src/worker.py",
  // On or after 2026-09-08 selects the Python 3.14 runtime.
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Each wallet movement is a data point (src/checkout/metrics.py, docs/metrics.md), in the host's local dataset.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "ask234_local_metrics" }],
  // The card and the simulated checkout page are text, read at startup.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "python_modules": { "exclude": ["**/*.pyc", "**/*.pyi"] },
  // Rechecks and event deliveries, as in the public deployment (local Queues, no account needed).
  "queues": {
    "producers": [
      { "binding": "PROVIDER_JOBS", "queue": "provider-jobs" },
      { "binding": "EVENT_JOBS", "queue": "event-jobs" }
    ],
    "consumers": [
      { "queue": "provider-jobs", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5 },
      { "queue": "event-jobs", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5 }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "checkout-demo",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PER_PAYMENT_LIMIT_KOBO": "5000000",
    "DAILY_LIMIT_KOBO": "10000000",
    "QUOTE_TTL_SECONDS": "600",
    "PUBLIC_BASE_URL": "http://localhost:8787"
  }
  // Secrets, set with `wrangler secret put NAME`; locally dummies in .dev.vars (never committed):
  //   APPROVAL_SECRET            required: signs the approval tokens
  //   INDEX_TOKEN_KEY            seals people's Paystack Index tokens (32+ characters); needed by INDEX_MODE=live,
  //                              and without it the simulated Index borrows a key from APPROVAL_SECRET
  //   OPS_TOKEN                  an operator's bearer for /ops/ (wallet corrections); unset, /ops/ answers 404
  //   PAYSTACK_TEST_SECRET_KEY   an sk_test_ key turns Paystack test mode on; a live key stops the Worker
  //   VTPASS_API_KEY, VTPASS_PUBLIC_KEY, VTPASS_SECRET_KEY   all three turn the VTpass sandbox on
  // Optional variables (defaults in src/checkout/config.py; with none set, a key decides: no key, simulated):
  //   REQUIRE_OWNER (1 refuses a tool call that names no owner; off, one default owner acts for such calls),
  //   PAYSTACK_MODE (simulated|test), a mode per connector
  //   (PAYSTACK_PAY_MODE, SEND_MONEY_MODE, AIRTIME_MODE, FOOD_ORDER_MODE, MERCHANTS_MODE: simulated|real), VTPASS_MODE
  //   (simulated|sandbox), CHECKOUT_WINDOW_SECONDS, PAYER_EMAIL, WALLET_ADJUST_TWO_OPERATORS_KOBO (above it a
  //   correction needs a second operator), and for the simulators SIM_TRANSFER_OTP,
  //   SIM_PAYOUTS_REFUSED, SIM_PENDING_SECONDS, FOOD_STEP_SECONDS, SIM_VTPASS_REJECT_CREDENTIALS.
  //   INDEX_MODE (simulated|live: whose Paystack Index a person's account is connected to; default simulated),
  //   INDEX_MCP_URL (live only: Index's MCP address, which must be https on index.mcp.paystack.africa or
  //   index.paystack.com; default https://index.mcp.paystack.africa/mcp), INDEX_CAPS_KOBO (JSON, 234's cap per order
  //   below Index's bounds, by airtime, electricity and food). Live also needs HOST_PUBLIC_URL to be https: Index
  //   sends the person back to the chat host's /connect/index/callback.
  //   BILLS_SERVICE_FEE_KOBO (whole kobo, default 0: the fee line on a television or electricity quote).
  //   FREE_TEXT_MERCHANTS (default on while every provider is simulated or in a sandbox; the Worker refuses
  //   it on beside any other, and the free-text create_payment_quote tool is offered only while it is on).
  //   HOST_PUBLIC_URL is the checkout page's way back to the chat and the origin of the host's event callbacks;
  //   HOST_BINDING names the service binding they go through (public deployment only). tools/up.sh sets them.
  // The /sim/checkout page belongs to the simulators: drop it (and ENABLE_TEST_ROUTES) in a public deployment.
}
