// Template of the public deployment of the connectors, simulated modes only. tools/deploy.sh fills in the
// @NAMES@ from its variables (the one place names live) and deploys the result; docs/deploy.md has the
// secrets and the runbook. wrangler.jsonc stays the local config.
{
  "name": "@CONNECTORS_WORKER@",
  "main": "src/worker.py",
  // On or after 2026-09-08 selects the Python 3.14 runtime.
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["python_workers"],
  // Every minute: approved quotes checked again with the provider, overdue ones expired, due events handed on.
  "triggers": { "crons": ["* * * * *"] },
  "workers_dev": true,
  // The most CPU time one request, queue batch or cron may use, in milliseconds (docs/deploy.md).
  "limits": { "cpu_ms": 15000 },
  "preview_urls": false,
  "observability": { "enabled": true },
  // Each wallet movement is a data point (src/checkout/metrics.py, docs/metrics.md), in the host's dataset.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "@METRICS_DATASET@" }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  // The chat host, reached through a service binding when an MCP event is for it (a Worker cannot fetch
  // another Worker of its account by the public address). The host already exists when the connectors deploy.
  "services": [{ "binding": "HOST", "service": "@HOST_WORKER@" }],
  // Rechecks a provider webhook asks for, and event deliveries: retried by the Queue, then dead-lettered.
  "queues": {
    "producers": [
      { "binding": "PROVIDER_JOBS", "queue": "@CONNECTORS_WORKER@-provider-jobs" },
      { "binding": "EVENT_JOBS", "queue": "@CONNECTORS_WORKER@-event-jobs" }
    ],
    "consumers": [
      { "queue": "@CONNECTORS_WORKER@-provider-jobs", "max_retries": 5, "dead_letter_queue": "@CONNECTORS_WORKER@-provider-jobs-dlq" },
      { "queue": "@CONNECTORS_WORKER@-event-jobs", "max_retries": 5, "dead_letter_queue": "@CONNECTORS_WORKER@-event-jobs-dlq" }
    ]
  },
  "python_modules": { "exclude": ["**/*.pyc", "**/*.pyi"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "@LEDGER_DB@",
      "database_id": "@LEDGER_DB_ID@",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PER_PAYMENT_LIMIT_KOBO": "5000000",
    "DAILY_LIMIT_KOBO": "10000000",
    "QUOTE_TTL_SECONDS": "600",
    "PUBLIC_BASE_URL": "https://@CONNECTORS_WORKER@.@SUBDOMAIN@.workers.dev",
    // Nothing on this Worker reaches Paystack or VTpass: every connector is simulated. A live key, if one
    // were ever set, stops the Worker at startup.
    "PAYSTACK_MODE": "simulated",
    "PAYSTACK_PAY_MODE": "simulated",
    "SEND_MONEY_MODE": "simulated",
    "AIRTIME_MODE": "simulated",
    "FOOD_ORDER_MODE": "simulated",
    "MERCHANTS_MODE": "simulated",
    "VTPASS_MODE": "simulated",
    // A person's Paystack Index account is the simulated one too: its sign-in page and tools are on this Worker
    // (/sim/index) and nothing reaches Index. Live needs INDEX_MODE=live, INDEX_TOKEN_KEY and an https HOST_PUBLIC_URL
    // (docs/deploy.md, docs/commerce.md).
    "INDEX_MODE": "simulated",
    // create_payment_quote may pay a merchant named only in words, which is harmless while every provider is
    // simulated. The Worker refuses it on beside any provider that is not simulated or in a sandbox
    // (docs/commerce.md, rule 2; docs/deploy.md).
    "FREE_TEXT_MERCHANTS": "1",
    // The tools answer only to a caller that holds MCP_ACCESS_TOKEN; without it the Worker does not start.
    "REQUIRE_MCP_TOKEN": "1",
    // Every tool call must say whose it is (the host sends the visitor's id): the daily limit is each
    // visitor's own, and a call with no owner is refused rather than pooled with anyone's.
    "REQUIRE_OWNER": "1",
    // The host's address: where the checkout page's "Return to the chat" link goes, and the origin of the
    // event callbacks it subscribes with, which go through HOST_BINDING.
    "HOST_PUBLIC_URL": "https://@HOST_WORKER@.@SUBDOMAIN@.workers.dev",
    "HOST_BINDING": "HOST",
    // /test routes reset the ledger and read inside it: never here.
    "ENABLE_TEST_ROUTES": "0"
  }
  // Secrets (docs/deploy.md): APPROVAL_SECRET, INDEX_TOKEN_KEY, MCP_ACCESS_TOKEN, and OPS_TOKEN for an operator's wallet
  // corrections (tools/deploy.sh secret connectors OPS_TOKEN; without it /ops/ answers 404).
}
